{
  "name": "broker-growth-desk",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:test:hosted-rest": "node supabase/tests/hosted-rest-rls.mjs",
    "db:test:hosted-operations": "node supabase/tests/hosted-lead-operations.mjs",
    "db:test:hosted-operations-cli": "supabase db query --remote=fgqgcikmaccjamwocpat --file supabase/tests/hosted-lead-operations-cli.sql --yes",
    "db:test:hosted-client-book": "node supabase/tests/hosted-client-book-runner.mjs",
    "db:test:hosted-review": "node supabase/tests/hosted-review-operations.mjs",
    "db:test:hosted-review-cli": "supabase db query --remote=fgqgcikmaccjamwocpat --file supabase/tests/hosted-review-operations-cli.sql --yes",
    "db:test:hosted-maintenance": "supabase db query --remote=fgqgcikmaccjamwocpat --file supabase/tests/hosted-client-maintenance-operations.sql --yes",
    "db:test:hosted-referrals": "supabase db query --remote=fgqgcikmaccjamwocpat --file supabase/tests/hosted-referral-partner-operations.sql --yes",
    "db:test:hosted-4f3": "supabase db query --remote=fgqgcikmaccjamwocpat --file supabase/tests/hosted-4f3-operations.sql --yes",
    "db:types": "supabase gen types --lang=typescript --schema public --remote=fgqgcikmaccjamwocpat > src/platform/database/database.types.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@tailwindcss/postcss": "^4.1.14",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/pg": "8.15.6",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.0.0",
    "jsdom": "^25.0.1",
    "pg": "8.16.3",
    "supabase": "3.1.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@11.25.0"
}
