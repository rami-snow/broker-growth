# fixture is the default and needs no Supabase configuration.
APP_RUNTIME_MODE=fixture

# Required only when APP_RUNTIME_MODE=supabase. Copy the hosted development
# project's public URL and publishable key into an ignored .env.local file.
# Never place a secret or service-role key in a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-development-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-development-publishable-key

# Required only for the Docker-free hosted operation verification suite.
# Supply these as temporary shell inputs; never commit a database URL or password.
SUPABASE_HOSTED_PROJECT_REF=replace-with-expected-development-project-reference
SUPABASE_HOSTED_DATABASE_URL=replace-with-temporary-tls-database-connection-string
